# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Step 2: Telegram bot ---------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs with unrestricted, cross-branch access.
# Find your own ID by messaging @userinfobot.
SUPER_ADMIN_TELEGRAM_IDS=

# --- Step 3: Flask admin ----------------------------------------------------
# Password for the admin review interface.
ADMIN_PASSWORD=

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Optional ---------------------------------------------------------------
# Override the SQLite file location. Defaults to ./data/family.db
# FAMILY_TREE_DB=/var/lib/family-tree/family.db
